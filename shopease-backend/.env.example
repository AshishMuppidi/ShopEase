# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/ecommerce_db
DB_USERNAME=root
DB_PASSWORD=

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT (Must be at least 256 bits / 32 bytes in production)
JWT_SECRET=your-secure-jwt-secret-key-at-least-256-bits-long-change-in-prod
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Payment Webhook HMAC Secret
PAYMENT_WEBHOOK_SECRET=your-secure-payment-webhook-secret-change-in-prod

# CORS Configuration (React frontend URL)
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Seeder Configuration (disabled by default in tests and production)
DUMMYJSON_ENABLED=false
